%% ===== TEMPLATE NOTES (delete this whole block when using) =====
%% Purpose:    Page flow diagram. Shows the menu entry points, the navigation between pages and
%%             the return paths.
%% Location:   docs/components/{component_code_name}/ui_page_design/
%%             (the only diagram that lives under ui_page_design/, managed alongside each page's
%%              code.html / screen.png)
%% File name:  {component_code_name}_page_flow.mmd; the PNG shares its name and directory.
%% Render:     mmdc -i {component_code_name}_page_flow.mmd \
%%                  -o {component_code_name}_page_flow.png -b white -s 3
%% Referenced: the "Page Flow Diagram" section at the very top of {component}_uiux.md
%% Style spec: see templates/mermaid/mmd_style_guide.md
%%             (1) white canvas  (2) boxes coloured by page type with light fills  (3) all text black
%% -
%% Edge conventions:
%%   solid  -->   explicit navigation between pages (menu entry, button jump, double-click a row to
%%                open a detail page, return after save)
%%   dashed -.->  non-navigational jumps (dashboard card drill-down, chart interactions, ...)
%%   Every edge MUST carry a trigger label |"..."| stating what the user did to cause the jump.
%% -
%% Consistency requirements (checked in review):
%%   The page IDs and names in this diagram must match uiux.md §2.1 Page List exactly;
%%   the menu structure must match uiux.md §2.2 Navigation Menu.
%% Usage:      Replace every {curly brace} placeholder; keep node IDs P01/P02... aligned with the
%%             page IDs.
%% ===============================================================
%%{init: {
  "theme": "base",
  "themeVariables": {
    "background": "#FFFFFF",
    "primaryColor": "#E3F2FD",
    "primaryTextColor": "#000000",
    "primaryBorderColor": "#1565C0",
    "secondaryColor": "#E8F5E9",
    "tertiaryColor": "#FFF3E0",
    "lineColor": "#616161",
    "textColor": "#000000",
    "titleColor": "#000000",
    "clusterBkg": "#FAFAFA",
    "clusterBorder": "#CCCCCC",
    "edgeLabelBackground": "#FFFFFF",
    "fontFamily": "Arial, sans-serif",
    "fontSize": "14px"
  }
}}%%
flowchart TD

    %% ========== Category styles (one light fill per category; text is always black) ==========
    classDef menuCls   fill:#FFF3E0,stroke:#EF6C00,color:#000000
    classDef listCls   fill:#E3F2FD,stroke:#1565C0,color:#000000
    classDef detailCls fill:#E8F5E9,stroke:#2E7D32,color:#000000
    classDef dashCls   fill:#F3E5F5,stroke:#6A1B9A,color:#000000
    classDef debugCls  fill:#FBE9E7,stroke:#D84315,color:#000000

    %% ========== Menu entry ==========
    MENU["Portal sidebar<br/>{ComponentName} menu group"]:::menuCls

    %% ========== Page nodes ==========
    P01["P01 {ListPage1Name}<br/>(Single-List Page)"]:::listCls
    P02["P02 {DetailPage1Name}<br/>(Business Object Detail Page)"]:::detailCls
    P03["P03 {ListPage2Name}<br/>(Dual-List Page)"]:::listCls
    P04["P04 {DetailPage2Name}<br/>(Read-Only Detail Page)"]:::detailCls
    P05["P05 {DashboardName}<br/>(Dashboard)"]:::dashCls
    P06["P06 API Debug Page<br/>(Two-Column Layout)"]:::debugCls

    %% ========== Menu -> page (solid, labelled with the menu item) ==========
    MENU -->|"menu: {Monitoring}"| P05
    MENU -->|"menu: {List1}"| P01
    MENU -->|"menu: {List2}"| P03
    MENU -->|"menu: API Debug"| P06

    %% ========== List page <-> detail page (solid, both ways, with trigger labels) ==========
    P01 -->|"click Create / double-click row / View / Edit"| P02
    P02 -->|"created / saved and closed / cancelled"| P01

    P03 -->|"double-click record / click View"| P04
    P04 -->|"click Close / deleted"| P03

    %% ========== Dashboard drill-down (dashed, non-navigational) ==========
    P05 -.->|"click: {StatCard1}"| P01
    P05 -.->|"click: {StatCard2}"| P03
    P05 -.->|"double-click: {recent error row}"| P04

    %% ========== Legend ==========
    subgraph legend["Legend"]
        direction LR
        LG1["Menu entry"]:::menuCls
        LG2["List page"]:::listCls
        LG3["Detail page"]:::detailCls
        LG4["Dashboard"]:::dashCls
        LG5["Debug page"]:::debugCls
    end

    %% ========== Container fill (lighter than the nodes; black text declared explicitly) ==========
    style legend fill:#F8F9FA,stroke:#CCCCCC,color:#000
