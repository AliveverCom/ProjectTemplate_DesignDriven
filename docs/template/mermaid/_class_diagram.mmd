%% ===== TEMPLATE NOTES (delete this whole block when using) =====
%% Purpose:    Class definition diagram. Shows this module's business entity classes, value objects
%%             and enums, plus the classes it references from other modules.
%% Location:   docs/components/{component_code_name}/
%% File name:  {component_code_name}_class_diagram.mmd; the PNG shares its name and directory.
%% Render:     mmdc -i {component_code_name}_class_diagram.mmd \
%%                  -o {component_code_name}_class_diagram.png -b white -s 3
%% Referenced: {component}_tech_design.md §2.1 Class Diagram
%% Style spec: see templates/mermaid/mmd_style_guide.md
%%             (1) white canvas  (2) class boxes coloured by type with light fills  (3) all text black
%% Usage:
%%   - Rename the classes (CBaseObject / CObjectA / EObjectStatus ...) to your real class names.
%%     Class names must NOT contain curly-brace placeholders, or mermaid fails to parse.
%%   - The same applies inside <<...>> annotations: no curly braces there either.
%%   - Every class must appear in the style statements at the end of the file.
%% -
%% IMPORTANT (verified against mermaid v11.16): classDiagram does NOT support classDef / cssClass /
%%   the ::: operator. None of them raise an error, but all three are silently ignored, leaving
%%   every class box in the same theme colour.
%%   The only colouring that works in a classDiagram is one statement per class:
%%   `style ClassName fill:...,stroke:...,color:#000000`.
%%   (flowchart / graph are the opposite: there, classDef + ::: is the correct approach.)
%% ===============================================================
%% -
%% ===== OWNERSHIP DECLARATION (mandatory; keep it after filling in real content) =====
%% Types authoritatively defined by this module ({component_code_name}):
%%   - CObjectA, CObjectB, CValueObject, EObjectStatus
%% Types referenced from other modules, drawn here only to show inheritance / association:
%%   - CBaseObject  -- abstract base class, authoritative definition in common_lib,
%%                     see common_lib_class_diagram.mmd
%%   - CRefObject   -- ordinary entity, authoritative definition in other_module,
%%                     see other_module_class_diagram.mmd
%% Referenced classes must never be modified here. To change a field, change the authoritative
%% module first, then update every place that references it.
%% -
%% ===== COLOUR SEMANTICS (a classDiagram has no subgraph, so the legend lives in comments) =====
%%   light blue   #E3F2FD baseCls   -- abstract base class
%%   light green  #E8F5E9 entityCls -- this module's business entity classes
%%   light cyan   #E0F7FA valueCls  -- value objects / nested structures (JSONB and similar)
%%   light yellow #FFF9C4 enumCls   -- enums
%%   light grey   #F5F5F5 refCls    -- ordinary entities referenced from another module
%% Classification precedence: an abstract base class stays light-blue baseCls even when it comes
%%   from common_lib; its "foreign" origin is conveyed by the <<abstract - ref: common_lib>>
%%   annotation. Light-grey refCls is reserved for non-base cross-module references.
%% ===============================================================
%%{init: {
  "theme": "base",
  "themeVariables": {
    "background": "#FFFFFF",
    "primaryColor": "#E3F2FD",
    "primaryTextColor": "#000000",
    "primaryBorderColor": "#1565C0",
    "lineColor": "#333333",
    "textColor": "#000000",
    "titleColor": "#000000",
    "classText": "#000000",
    "clusterBkg": "#FAFAFA",
    "clusterBorder": "#CCCCCC",
    "edgeLabelBackground": "#FFFFFF",
    "fontFamily": "Arial, sans-serif",
    "fontSize": "13px"
  }
}}%%

classDiagram
    direction TB

    %% ========== Abstract base class (cross-module reference; authoritative in common_lib) ==========
    class CBaseObject {
        <<abstract - ref: common_lib>>
        +int object_id  PK auto-increment
        +string display_name  NOT NULL UNIQUE
        +string code_name  NOT NULL UNIQUE
        +string description = ""
        +bool is_active = true
        +datetime? deleted_at
        +datetime created_at = NOW()
        +datetime updated_at = NOW()
    }

    %% ========== This module's business entity classes ==========
    class CObjectA {
        +EObjectStatus status  NOT NULL
        +CValueObject metrics  NOT NULL
        +string? optional_field
        +string[] tag_list
        +int retry_count = 0
        +validate() bool
        +toDTO() CObjectADTO
    }

    class CObjectB {
        +int object_b_id  PK auto-increment
        +int object_a_id  FK NOT NULL
        +string title  NOT NULL
        +datetime? processed_at
        +datetime created_at = NOW()
    }

    %% ========== Value object / nested structure (stored as JSONB) ==========
    class CValueObject {
        <<value object>>
        +int metric_one = -1
        +int metric_two = -1
        +int metric_three = -1
    }

    %% ========== Enum (authoritatively defined by this module) ==========
    class EObjectStatus {
        <<enumeration>>
        PLANNED
        RUNNING
        SUCCEEDED
        FAILED
        CANCELED
    }

    %% ========== Cross-module reference class (drawn only to complete the picture) ==========
    class CRefObject {
        <<ref: other_module>>
        +int ref_id  PK
        +string code_name  NOT NULL UNIQUE
    }

    %% ========== Relationships ==========
    CBaseObject <|-- CObjectA : inherits
    CObjectA "1" --> "0..*" CObjectB : one A owns many B
    CObjectA "1" *-- "1" CValueObject : composition (embedded JSONB)
    CObjectA ..> EObjectStatus : uses
    CObjectB "0..*" --> "1" CRefObject : cross-module association

    %% ========== Category colouring (one style per class, grouped; no class may be missed) ==========
    %% ----- baseCls abstract base class: light blue -----
    style CBaseObject   fill:#E3F2FD,stroke:#1565C0,color:#000000
    %% ----- entityCls this module's business entities: light green -----
    style CObjectA      fill:#E8F5E9,stroke:#2E7D32,color:#000000
    style CObjectB      fill:#E8F5E9,stroke:#2E7D32,color:#000000
    %% ----- valueCls value object / nested structure: light cyan -----
    style CValueObject  fill:#E0F7FA,stroke:#00838F,color:#000000
    %% ----- enumCls enum: light yellow -----
    style EObjectStatus fill:#FFF9C4,stroke:#F9A825,color:#000000
    %% ----- refCls cross-module ordinary entity: light grey -----
    style CRefObject    fill:#F5F5F5,stroke:#616161,color:#000000
