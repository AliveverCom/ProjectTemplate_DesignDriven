---
title: "{PlatformName} — Technical Architecture Overview"
---
%% ===== TEMPLATE NOTES (delete this whole block when using) =====
%% Purpose:    Technical architecture diagram. Nodes are grouped and coloured by ARCHITECTURE LAYER,
%%             showing what each layer contains and the direction of calls between layers.
%% Location:   docs/ (platform-level diagram, no component prefix)
%% File name:  technical_architecture.mmd; the PNG shares its name and directory.
%% Render:     mmdc -i technical_architecture.mmd -o technical_architecture.png -b white -s 3
%% Referenced: technical_overview.md §1.1 Architecture Overview
%% Style spec: see templates/mermaid/mmd_style_guide.md
%%             (1) white canvas  (2) boxes coloured by layer with light fills  (3) all text black
%% Caution:    The YAML front matter (--- title ---) MUST be the very first thing in the file;
%%             nothing may precede it.
%% Usage:      Replace every {curly brace} placeholder. Add or remove component-layer nodes to match
%%             the real component count, but every node must keep its :::xxxCls classification.
%% ===============================================================
%%{init: {
  "theme": "base",
  "themeVariables": {
    "background": "#FFFFFF",
    "primaryColor": "#E3F2FD",
    "primaryTextColor": "#000000",
    "primaryBorderColor": "#1565C0",
    "secondaryColor": "#E8F5E9",
    "tertiaryColor": "#FFF9C4",
    "lineColor": "#555555",
    "textColor": "#000000",
    "titleColor": "#000000",
    "clusterBkg": "#FAFAFA",
    "clusterBorder": "#CCCCCC",
    "edgeLabelBackground": "#FFFFFF",
    "fontFamily": "Arial, sans-serif",
    "fontSize": "14px"
  }
}}%%
graph TB

    %% ========== Category styles (one light fill per layer; text is always black) ==========
    classDef clientCls    fill:#E3F2FD,stroke:#1565C0,color:#000000
    classDef gatewayCls   fill:#FFF3E0,stroke:#EF6C00,color:#000000
    classDef portalCls    fill:#E0F7FA,stroke:#00838F,color:#000000
    classDef componentCls fill:#E8F5E9,stroke:#2E7D32,color:#000000
    classDef serviceCls   fill:#F3E5F5,stroke:#6A1B9A,color:#000000
    classDef dataCls      fill:#FADBD8,stroke:#C0392B,color:#000000
    classDef externalCls  fill:#F5F5F5,stroke:#616161,color:#000000

    %% ========== Client layer ==========
    subgraph client_layer["Client Layer"]
        direction LR
        CL1["🌐 {Web browser}"]:::clientCls
        CL2["📱 {Mobile / other clients}"]:::clientCls
    end

    %% ========== Gateway layer ==========
    subgraph gateway_layer["Gateway Layer"]
        direction LR
        GW1["{API Gateway}<br/>{routing · rate limiting · forwarding}"]:::gatewayCls
        GW2["{Auth and permission service}<br/>{OAuth · JWT}"]:::gatewayCls
        GW1 <--> GW2
    end

    %% ========== Portal layer ==========
    subgraph portal_layer["Portal Layer"]
        PT1["{unified_portal}<br/>{shared menu · view shell · dashboard}"]:::portalCls
    end

    %% ========== Product component layer ==========
    subgraph comp_layer["Product Component Layer — each component owns its frontend, backend and database"]
        direction LR
        CP1["{Component1Name}<br/>{component_code_name_1}"]:::componentCls
        CP2["{Component2Name}<br/>{component_code_name_2}"]:::componentCls
        CP3["{Component3Name}<br/>{component_code_name_3}"]:::componentCls
    end

    %% ========== Shared service layer ==========
    subgraph service_layer["Shared Service Layer"]
        direction LR
        SV1["{Workflow orchestrator}"]:::serviceCls
        SV2["{AI agent service}"]:::serviceCls
    end

    %% ========== Data layer ==========
    subgraph data_layer["Data Layer"]
        direction LR
        DB1[("{PostgreSQL}<br/>{one database per component}")]:::dataCls
        DB2[("{File storage}<br/>{video · audio · images}")]:::dataCls
        DB3[("{Redis cache}")]:::dataCls
    end

    %% ========== External systems ==========
    subgraph ext_layer["External Systems"]
        direction LR
        EX1["☁️ {Cloud auth provider}"]:::externalCls
        EX2["🌍 {External data sources}"]:::externalCls
        EX3["📡 {Outbound publishing platforms}"]:::externalCls
    end

    %% ========== Legend ==========
    subgraph legend["Legend"]
        direction LR
        LG1["Client layer"]:::clientCls
        LG2["Gateway layer"]:::gatewayCls
        LG3["Portal layer"]:::portalCls
        LG4["Product component layer"]:::componentCls
        LG5["Shared service layer"]:::serviceCls
        LG6[("Data layer")]:::dataCls
        LG7["External systems"]:::externalCls
    end

    %% ========== Calls between layers ==========
    CL1 --> GW1
    CL2 --> GW1
    GW1 --> PT1
    PT1 --> CP1
    PT1 --> CP2
    PT1 --> CP3
    CP1 --> SV1
    CP2 --> SV1
    CP3 --> SV2
    CP1 --> DB1
    CP2 --> DB1
    CP3 --> DB2
    SV1 --> DB3
    GW2 -.->|"{delegated auth}"| EX1
    CP2 -.->|"{fetch}"| EX2
    CP3 -.->|"{publish}"| EX3

    %% ========== Container fills (lighter than the nodes; black text declared explicitly) ==========
    style client_layer  fill:#F5FAFE,stroke:#1565C0,color:#000
    style gateway_layer fill:#FFFAF3,stroke:#EF6C00,color:#000
    style portal_layer  fill:#F2FBFC,stroke:#00838F,color:#000
    style comp_layer    fill:#F5FCF7,stroke:#2E7D32,color:#000
    style service_layer fill:#FBF6FD,stroke:#6A1B9A,color:#000
    style data_layer    fill:#FEF7F6,stroke:#C0392B,color:#000
    style ext_layer     fill:#FAFAFA,stroke:#CCCCCC,color:#000
    style legend        fill:#F8F9FA,stroke:#CCCCCC,color:#000
