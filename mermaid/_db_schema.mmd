%% ===== TEMPLATE NOTES (delete this whole block when using) =====
%% Purpose:    Database schema (ER) diagram. Uses namespaces to partition by database / logical
%%             group, showing tables, column types, keys and relationships between tables.
%% Location:   docs/components/{component_code_name}/
%% File name:  {component_code_name}_db_schema.mmd; the PNG shares its name and directory.
%% Render:     mmdc -i {component_code_name}_db_schema.mmd \
%%                  -o {component_code_name}_db_schema.png -b white -s 3
%% Referenced: {component}_tech_design.md §4.0 Database Schema Diagram
%% Style spec: see templates/mermaid/mmd_style_guide.md
%%             (1) white canvas  (2) table boxes coloured by type with light fills  (3) all text black
%% -
%% Column type prefixes (written before the member name so constraints are visible at a glance):
%%   +INT_PK      primary key (auto-increment integer)   +INT_FK      foreign key
%%   +TEXT_PK     primary key (text)                     +TEXT_UK     unique text column
%%   +TEXT        plain text                             +INT         integer
%%   +BOOLEAN     boolean                                +JSONB       structured field
%%   +TIMESTAMPTZ timestamp with time zone               +NUMERIC     fixed-point number
%%   +BYTEA       binary
%% Nullable columns take a `?` after the TYPE (consistent with the class diagram),
%% e.g. `+TIMESTAMPTZ? deleted_at`
%% -
%% Usage:
%%   - Rename tables and namespaces to your real names. They must NOT contain curly-brace
%%     placeholders, or mermaid fails to parse.
%%   - Dynamic sharded tables are expressed with a `<<template: ...>>` annotation. Annotations
%%     cannot contain curly braces either, so write `code_name_mrecord`, meaning
%%     `{code_name}_mrecord`.
%%   - Every table must appear in the style statements at the end of the file.
%% -
%% IMPORTANT (verified against mermaid v11.16): classDiagram does NOT support classDef / cssClass /
%%   the ::: operator. None of them raise an error, but all three are silently ignored, leaving
%%   every table box in the same theme colour.
%%   The only colouring that works in a classDiagram is one statement per table:
%%   `style TableName fill:...,stroke:...,color:#000000`. This also works for tables declared
%%   inside a namespace (verified).
%% ===============================================================
%% -
%% ===== COLOUR SEMANTICS (a classDiagram has no subgraph, so the legend lives in comments) =====
%%   light blue   #E3F2FD tableCls    -- this module's ordinary business tables
%%   light orange #FFF3E0 templateCls -- dynamic shard template (many identical tables derived
%%                                       from code_name)
%%   light yellow #FFF9C4 lookupCls   -- lookup / configuration / persisted-enum tables
%%   light grey   #F5F5F5 refTableCls -- cross-database reference tables (authoritative in another
%%                                       module's database)
%% ===============================================================
%%{init: {
  "theme": "base",
  "themeVariables": {
    "background": "#FFFFFF",
    "primaryColor": "#E3F2FD",
    "primaryTextColor": "#000000",
    "primaryBorderColor": "#1565C0",
    "lineColor": "#333333",
    "textColor": "#000000",
    "titleColor": "#000000",
    "classText": "#000000",
    "clusterBkg": "#FAFAFA",
    "clusterBorder": "#CCCCCC",
    "edgeLabelBackground": "#FFFFFF",
    "fontFamily": "Arial, sans-serif",
    "fontSize": "12px"
  }
}}%%

classDiagram
    direction TB

    %% ========== Database 1: main business database ==========
    namespace main_db {
        class main_object {
            <<Table>>
            +INT_PK object_id
            +TEXT_UK display_name
            +TEXT_UK code_name
            +TEXT object_type
            +TEXT object_url
            +TEXT description
            +JSONB metrics
            +JSONB tag_list
            +INT retry_count
            +BOOLEAN is_active
            +TIMESTAMPTZ? deleted_at
            +TIMESTAMPTZ created_at
            +TIMESTAMPTZ updated_at
        }

        class main_object_detail {
            <<Table>>
            +INT_PK detail_id
            +INT_FK object_id
            +TEXT title
            +TEXT content
            +TEXT lang
            +TIMESTAMPTZ? processed_at
            +TIMESTAMPTZ created_at
            +TIMESTAMPTZ updated_at
        }

        class object_type_lookup {
            <<Table - lookup>>
            +TEXT_PK type_code
            +TEXT type_label
            +INT sort_order
            +BOOLEAN is_active
        }
    }

    %% ========== Database 2: dynamic shard database ==========
    %% Each code_name derives one set of identical tables:
    %% code_name_mrecord / code_name_plan / code_name_done
    namespace shard_db {
        class code_name_mrecord {
            <<template: code_name_mrecord>>
            +INT_PK rec_id
            +TEXT object_code_name
            +TEXT title
            +TEXT summary
            +TEXT full_text
            +TEXT link
            +TEXT link_md5
            +JSONB metrics
            +TIMESTAMPTZ? pub_date
            +TIMESTAMPTZ first_seen_at
            +TIMESTAMPTZ? processed_at
        }

        class code_name_plan {
            <<template: code_name_plan>>
            +INT_PK task_id
            +TEXT exe_name
            +TEXT exe_status
            +TEXT task_param
            +TIMESTAMPTZ task_create
            +TIMESTAMPTZ? exe_start
        }

        class code_name_done {
            <<template: code_name_done>>
            +INT_PK task_id
            +TEXT exe_name
            +TEXT exe_status
            +TEXT exe_message
            +TIMESTAMPTZ task_create
            +TIMESTAMPTZ exe_start
            +TIMESTAMPTZ exe_end
        }
    }

    %% ========== Cross-database reference table (authoritative in another module) ==========
    namespace other_module_db {
        class ref_table {
            <<Table - ref: other_module>>
            +INT_PK ref_id
            +TEXT_UK code_name
            +BOOLEAN is_active
        }
    }

    %% ========== Relationships ==========
    main_object "1" --> "0..*" main_object_detail : object_id foreign key
    main_object "0..*" --> "1" object_type_lookup : object_type value constraint
    main_object "1" ..> "1" code_name_mrecord : shard derived from code_name
    main_object "1" ..> "1" code_name_plan : shard derived from code_name
    code_name_plan "1" --> "0..1" code_name_done : archived once the task finishes
    main_object "0..*" ..> "1" ref_table : cross-database logical link (no FK constraint)

    %% ========== Category colouring (one style per table, grouped; no table may be missed) ==========
    %% ----- tableCls ordinary business tables: light blue -----
    style main_object        fill:#E3F2FD,stroke:#1565C0,color:#000000
    style main_object_detail fill:#E3F2FD,stroke:#1565C0,color:#000000
    %% ----- templateCls dynamic shard templates: light orange -----
    style code_name_mrecord  fill:#FFF3E0,stroke:#EF6C00,color:#000000
    style code_name_plan     fill:#FFF3E0,stroke:#EF6C00,color:#000000
    style code_name_done     fill:#FFF3E0,stroke:#EF6C00,color:#000000
    %% ----- lookupCls lookup / configuration tables: light yellow -----
    style object_type_lookup fill:#FFF9C4,stroke:#F9A825,color:#000000
    %% ----- refTableCls cross-database reference tables: light grey -----
    style ref_table          fill:#F5F5F5,stroke:#616161,color:#000000
