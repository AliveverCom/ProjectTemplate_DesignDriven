---
title: "{ComponentName} — Business Process"
---
%% ===== TEMPLATE NOTES (delete this whole block when using) =====
%% Purpose:    Business process diagram. Nodes are grouped and coloured by ROLE, showing the
%%             end-to-end business flow including branches and loops.
%% Location:   component level -> docs/components/{component_code_name}/
%%             platform level  -> docs/
%% File name:  {component_code_name}_business_process.mmd (platform level: business_process.mmd)
%%             The PNG shares the same name and directory as the .mmd.
%% Render:     mmdc -i {component_code_name}_business_process.mmd \
%%                  -o {component_code_name}_business_process.png -b white -s 3
%% Referenced: {component}_business_desc.md §4.1 Process Diagram
%% Style spec: see templates/mermaid/mmd_style_guide.md
%%             (1) white canvas  (2) boxes coloured by role with light fills  (3) all text black
%% Caution:    The YAML front matter (--- title ---) MUST be the very first thing in the file;
%%             nothing may precede it.
%% Usage:      Replace every {curly brace} placeholder. Node IDs (A1/B1/...) may be renamed, but
%%             every node must keep its :::xxxCls classification.
%% ===============================================================
%%{init: {
  "theme": "base",
  "themeVariables": {
    "background": "#FFFFFF",
    "primaryColor": "#E3F2FD",
    "primaryTextColor": "#000000",
    "primaryBorderColor": "#1565C0",
    "secondaryColor": "#E8F5E9",
    "tertiaryColor": "#FFF9C4",
    "lineColor": "#555555",
    "textColor": "#000000",
    "titleColor": "#000000",
    "clusterBkg": "#FAFAFA",
    "clusterBorder": "#CCCCCC",
    "edgeLabelBackground": "#FFFFFF",
    "fontFamily": "Arial, sans-serif",
    "fontSize": "14px"
  }
}}%%
graph TD

    %% ========== Category styles (one light fill per category; text is always black) ==========
    classDef roleACls    fill:#E3F2FD,stroke:#1565C0,color:#000000
    classDef roleBCls    fill:#F3E5F5,stroke:#6A1B9A,color:#000000
    classDef roleCCls    fill:#E8F5E9,stroke:#2E7D32,color:#000000
    classDef systemCls   fill:#FFF3E0,stroke:#EF6C00,color:#000000
    classDef decisionCls fill:#FFF9C4,stroke:#F9A825,color:#000000
    classDef dataCls     fill:#FADBD8,stroke:#C0392B,color:#000000

    %% ========== Step 1: {RoleA} — {StageName} ==========
    subgraph step1["1. {RoleA}: {StageName}"]
        direction TB
        A1["1a. {ActionDescription}<br/>👤 {RoleA}"]:::roleACls
        A2["1b. {ActionDescription}<br/>👤 {RoleA}"]:::roleACls
        A3[("💾 {BusinessObjectProduced}")]:::dataCls
        A1 --> A2 --> A3
    end

    %% ========== Step 2: {RoleB} — {StageName} ==========
    subgraph step2["2. {RoleB}: {StageName}"]
        direction TB
        B1["2a. {ActionDescription}<br/>👤 {RoleB}"]:::roleBCls
        B2["2b. {AutomatedAction}<br/>🤖 Automated"]:::systemCls
        B3["2c. {ActionDescription}<br/>👤 {RoleB}"]:::roleBCls
        B1 --> B2 --> B3
    end

    %% ========== Step 3: {RoleC} — {StageName} ==========
    subgraph step3["3. {RoleC}: {StageName}"]
        direction TB
        C1["3a. {ActionDescription}<br/>👤 {RoleC}"]:::roleCCls
        C2["3b. {ActionDescription}<br/>👤 {RoleC}"]:::roleCCls
        C3{"3c. {DecisionPoint}<br/>👤 {RoleC}"}:::decisionCls
        C1 --> C2 --> C3
        C3 -->|"{rejected: needs revision}"| C2
    end

    %% ========== Step 4: {RoleA} — {StageName} ==========
    subgraph step4["4. {RoleA}: {StageName}"]
        direction TB
        D1["4a. {ActionDescription}<br/>👤 {RoleA}"]:::roleACls
        D2["4b. {ActionDescription}<br/>👤 {RoleA}"]:::roleACls
        D1 --> D2
    end

    %% ========== Legend ==========
    subgraph legend["Legend"]
        direction LR
        LG1["{RoleA}"]:::roleACls
        LG2["{RoleB}"]:::roleBCls
        LG3["{RoleC}"]:::roleCCls
        LG4["Automated"]:::systemCls
        LG5{"Human decision"}:::decisionCls
        LG6[("Data produced")]:::dataCls
    end

    %% ========== Step-to-step links (node to node, to keep the layout strictly vertical) ==========
    A3 --> B1
    B3 --> C1
    C3 -->|"{approved}"| D1
    D2 -.->|"{next iteration}"| A1

    %% ========== Container fills (lighter than the nodes; black text declared explicitly) ==========
    style step1  fill:#F5FAFE,stroke:#1565C0,color:#000
    style step2  fill:#FBF6FD,stroke:#6A1B9A,color:#000
    style step3  fill:#F5FCF7,stroke:#2E7D32,color:#000
    style step4  fill:#F5FAFE,stroke:#1565C0,color:#000
    style legend fill:#F8F9FA,stroke:#CCCCCC,color:#000
