%% ===== TEMPLATE NOTES (delete this whole block when using) =====
%% Purpose:    API call graph. Frontend pages on the left, REST endpoints grouped by
%%             tech_design §5.x on the right; edges show which page calls which endpoint, and
%%             cross-module callers are marked explicitly.
%% Location:   docs/components/{component_code_name}/
%% File name:  {component_code_name}_api.mmd; the PNG shares its name and directory.
%% Render:     mmdc -i {component_code_name}_api.mmd \
%%                  -o {component_code_name}_api.png -b white -s 3
%% Referenced: {component}_tech_design.md §5.0 API Overview Diagram
%% Style spec: see templates/mermaid/mmd_style_guide.md
%%             (1) white canvas  (2) boxes coloured by type with light fills  (3) all text black
%% Consistency requirements (checked in review):
%%   The endpoint count and paths in this diagram must match tech_design §5 item by item, and must
%%   agree with uiux.md §2.3 Page-Object-API Mapping and the endpoint list on the P{nn} API debug
%%   page — all three must be in sync.
%% Usage:      Replace every {curly brace} placeholder; keep node IDs in the `GROUP_ACTION` form so
%%             they stay searchable.
%% ===============================================================
%%{init: {
  "theme": "base",
  "themeVariables": {
    "background": "#FFFFFF",
    "primaryColor": "#E0F7FA",
    "primaryTextColor": "#000000",
    "primaryBorderColor": "#00838F",
    "secondaryColor": "#E8F5E9",
    "tertiaryColor": "#F5F5F5",
    "lineColor": "#616161",
    "textColor": "#000000",
    "titleColor": "#000000",
    "clusterBkg": "#FAFAFA",
    "clusterBorder": "#CCCCCC",
    "edgeLabelBackground": "#FFFFFF",
    "fontFamily": "Arial, sans-serif",
    "fontSize": "12px"
  }
}}%%
graph LR

    %% ========== Category styles (one light fill per category; text is always black) ==========
    classDef pageCls fill:#E0F7FA,stroke:#00838F,color:#000000
    classDef apiCls  fill:#E8F5E9,stroke:#2E7D32,color:#000000
    classDef extCls  fill:#F5F5F5,stroke:#616161,color:#000000

    %% ========== Callers: this component's frontend pages ==========
    P01["P01 {Page1Name}"]:::pageCls
    P02["P02 {Page2Name}"]:::pageCls
    P03["P03 {Page3Name}"]:::pageCls
    P04["P04 {DashboardName}"]:::pageCls
    P05["P05 API Debug Page"]:::pageCls

    %% ========== Callers: cross-module ==========
    EXT1["{other_module}<br>cross-module caller"]:::extCls

    %% ========== §5.1 {MainObject} CRUD ==========
    subgraph OBJ["§5.1 {MainObject} CRUD"]
        direction TB
        OBJ_LIST["GET /{resource}<br>list"]:::apiCls
        OBJ_GET["GET /{resource}/{id}<br>get one"]:::apiCls
        OBJ_POST["POST /{resource}<br>create"]:::apiCls
        OBJ_PUT["PUT /{resource}/{id}<br>update"]:::apiCls
        OBJ_DEL["DELETE /{resource}/{id}<br>soft delete"]:::apiCls
    end

    %% ========== §5.2 {SubObject} queries ==========
    subgraph SUB["§5.2 {SubObject} Queries"]
        direction TB
        SUB_LIST["GET /{sub-resource}<br>list"]:::apiCls
        SUB_GET["GET /{sub-resource}/{id}<br>get one"]:::apiCls
        SUB_BDEL["POST /{sub-resource}/batch-delete<br>batch delete"]:::apiCls
    end

    %% ========== §5.3 {Run state and statistics} ==========
    subgraph STAT["§5.3 {Run State and Statistics}"]
        direction TB
        STAT_STATUS["GET /{daemons}/status<br>run state"]:::apiCls
        STAT_SUM["GET /stats/summary<br>statistics summary"]:::apiCls
        STAT_ERR["GET /stats/recent-errors<br>recent errors"]:::apiCls
    end

    %% ========== Page -> endpoint calls ==========
    P01 --> OBJ_LIST
    P01 --> OBJ_DEL
    P02 --> OBJ_GET
    P02 --> OBJ_POST
    P02 --> OBJ_PUT
    P03 --> SUB_LIST
    P03 --> SUB_BDEL
    P03 --> OBJ_LIST
    P04 --> STAT_STATUS
    P04 --> STAT_SUM
    P04 --> STAT_ERR

    %% ========== The API debug page covers every endpoint (dashed, to avoid edge clutter) ==========
    P05 -.->|"covers all endpoints"| OBJ
    P05 -.->|"covers all endpoints"| SUB
    P05 -.->|"covers all endpoints"| STAT

    %% ========== Cross-module calls (dashed, with an explanatory label) ==========
    EXT1 -.->|"{when and why it calls}"| OBJ_LIST
    EXT1 -.->|"{when and why it calls}"| OBJ_GET

    %% ========== Legend ==========
    subgraph legend["Legend"]
        direction LR
        LG1["Frontend page"]:::pageCls
        LG2["REST endpoint"]:::apiCls
        LG3["Cross-module caller"]:::extCls
    end

    %% ========== Container fills (lighter than the nodes; black text declared explicitly) ==========
    style OBJ    fill:#F5FCF7,stroke:#2E7D32,color:#000
    style SUB    fill:#F5FCF7,stroke:#2E7D32,color:#000
    style STAT   fill:#F5FCF7,stroke:#2E7D32,color:#000
    style legend fill:#F8F9FA,stroke:#CCCCCC,color:#000
